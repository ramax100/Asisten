# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram-panel?retryWrites=true&w=majority

# Session Secret (random string, min 32 characters)
SESSION_SECRET=your-secret-key-min-32-characters-long

# Base URL (untuk webhook)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
