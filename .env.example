# MongoDB Connection String
# Dapatkan dari MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/botpanel?retryWrites=true&w=majority

# Admin Login (ganti dengan credential Anda sendiri!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_ini

# Base URL (opsional - otomatis terdeteksi dari request/Vercel)
# Hanya perlu di-set jika pakai custom domain yang berbeda
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
